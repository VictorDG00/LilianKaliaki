# sempre atualizar arquivo /app/config.py com as variáveis de ambiente do arquivo .env.exemple

# Banco de dados
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db
SECRET_KEY=troque_por_uma_chave_aleatoria

# Producao (Infra/docker-compose.prod.yml, VPS) - nao usada em dev.
# APP_PORT saiu: a app nao publica mais porta no host, quem a alcanca e o
# nginx-proxy pela rede Docker vps-proxy.
DB_PASSWORD=troque_por_uma_senha_forte_do_postgres

# Pagamento
MERCADO_PAGO_ACCESS_TOKEN=seu_access_token_aqui
MERCADO_PAGO_WEBHOOK_SECRET=seu_webhook_secret_aqui
MERCADO_PAGO_PUBLIC_KEY=sua_public_key_aqui

# Admin (/admin)
ADMIN_USERNAME=troque_este_usuario
ADMIN_PASSWORD=troque_por_uma_senha_forte

# Loga todo SQL (com os parametros) no stdout. So para debug local: em producao
# o stdout vai pro Loki e os parametros incluem nome/email/telefone dos contatos.
SQL_ECHO=false

# Cookie de sessao so trafega em HTTPS. Manter true em producao.
SESSION_HTTPS_ONLY=true